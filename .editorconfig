root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
tab_width = 4
trim_trailing_whitespace = true

[*.md]
indent_size = 2
max_line_length = off

[{package.json,pnpm-*.yaml}]
indent_size = 2

# caddy fmt indents with tabs, and Caddy warns about a Caddyfile that it would format.
[Caddyfile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
