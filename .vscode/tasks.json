{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "root:format",
            "type": "shell",
            "command": "pnpm moon run root:format",
            "problemMatcher": []
        },
        {
            "label": "root:format-check",
            "type": "shell",
            "command": "pnpm moon run root:format-check",
            "problemMatcher": []
        },
        {
            "label": "root:lint-md",
            "type": "shell",
            "command": "pnpm moon run root:lint-md",
            "problemMatcher": []
        },
        {
            "label": "web:start",
            "type": "shell",
            "command": "pnpm moon run web:start",
            "isBackground": true,
            "problemMatcher": {
                "owner": "typescript",
                "pattern": "$tsc",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": {
                        "regexp": "Changes detected"
                    },
                    "endsPattern": {
                        "regexp": "bundle generation (complete|failed)"
                    }
                }
            }
        },
        {
            "label": "web:build",
            "type": "shell",
            "command": "pnpm moon run web:build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "web:test",
            "type": "shell",
            "command": "pnpm moon run web:test",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "web:test-ci",
            "type": "shell",
            "command": "pnpm moon run web:test-ci",
            "problemMatcher": []
        },
        {
            "label": "web:lint",
            "type": "shell",
            "command": "pnpm moon run web:lint",
            "problemMatcher": "$eslint-stylish"
        },
        {
            "label": "web-e2e:e2e",
            "type": "shell",
            "command": "pnpm moon run web-e2e:e2e",
            "problemMatcher": []
        },
        {
            "label": "web-e2e:e2e-ci",
            "type": "shell",
            "command": "pnpm moon run web-e2e:e2e-ci",
            "problemMatcher": []
        },
        {
            "label": "web-e2e:typecheck",
            "type": "shell",
            "command": "pnpm moon run web-e2e:typecheck",
            "problemMatcher": "$tsc"
        },
        {
            "label": "web-e2e:lint",
            "type": "shell",
            "command": "pnpm moon run web-e2e:lint",
            "problemMatcher": "$eslint-stylish"
        }
    ]
}
