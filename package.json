{
  "name": "dnd-mapp",
  "description": "The monorepo for D&D Mapp: all packages and applications of the project.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/dnd-mapp/dnd-mapp#readme",
  "bugs": "https://github.com/dnd-mapp/dnd-mapp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnd-mapp/dnd-mapp.git"
  },
  "scripts": {
    "moon": "moon"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:commitlint",
    "@commitlint/config-conventional": "catalog:commitlint",
    "@moonrepo/cli": "catalog:moon",
    "lefthook": "catalog:lefthook",
    "markdownlint-cli2": "catalog:markdownlint",
    "playwright": "catalog:playwright",
    "prettier": "catalog:prettier"
  }
}
