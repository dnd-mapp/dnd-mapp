        "regions-footer--desktop": {
          "id": "regions-footer--desktop",
          "name": "Desktop",
          "snippet": "import { Component } from '@angular/core';\nimport { FooterComponent } from './footer.component';\nimport { LinkGroupComponent } from '../link-group';\nimport { LinkComponent } from '../link';\n\n@Component({\n  selector: 'app-demo',\n  imports: [FooterComponent, LinkGroupComponent, LinkComponent],\n  template: `\n    <footer dma-footer>\n        <nav aria-labelledby=\"footer-product\">\n            <dma-link-group>\n                <h2 id=\"footer-product\">Product</h2>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Compendium</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Dice</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Characters</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Campaigns</a>\n                </li>\n            </dma-link-group>\n        </nav>\n        <nav aria-labelledby=\"footer-project\">\n            <dma-link-group>\n                <h2 id=\"footer-project\">Project</h2>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">GitHub</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Contributing</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Code of conduct</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Support</a>\n                </li>\n            </dma-link-group>\n        </nav>\n        <nav aria-labelledby=\"footer-legal\">\n            <dma-link-group>\n                <h2 id=\"footer-legal\">Legal</h2>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Privacy</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Accessibility</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">License</a>\n                </li>\n            </dma-link-group>\n        </nav>\n    </footer>`,\n})\nexport class DemoComponent {}",
          "description": "The brand beside the columns, and the legal text beside the Theme picker, from the desktop breakpoint up."
        },
        "regions-footer--mobile": {
          "id": "regions-footer--mobile",
          "name": "Mobile",
          "snippet": "import { Component } from '@angular/core';\nimport { FooterComponent } from './footer.component';\nimport { LinkGroupComponent } from '../link-group';\nimport { LinkComponent } from '../link';\n\n@Component({\n  selector: 'app-demo',\n  imports: [FooterComponent, LinkGroupComponent, LinkComponent],\n  template: `\n    <footer dma-footer>\n        <nav aria-labelledby=\"footer-product\">\n            <dma-link-group>\n                <h2 id=\"footer-product\">Product</h2>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Compendium</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Dice</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Characters</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Campaigns</a>\n                </li>\n            </dma-link-group>\n        </nav>\n        <nav aria-labelledby=\"footer-project\">\n            <dma-link-group>\n                <h2 id=\"footer-project\">Project</h2>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">GitHub</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Contributing</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Code of conduct</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Support</a>\n                </li>\n            </dma-link-group>\n        </nav>\n        <nav aria-labelledby=\"footer-legal\">\n            <dma-link-group>\n                <h2 id=\"footer-legal\">Legal</h2>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Privacy</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">Accessibility</a>\n                </li>\n                <li>\n                    <a dma-link kind=\"quiet\" href=\"#\">License</a>\n                </li>\n            </dma-link-group>\n        </nav>\n    </footer>`,\n})\nexport class DemoComponent {}",
          "description": "Every part stacks in one column, below the desktop breakpoint. The docs page shows the story in an iframe narrower\nthan the breakpoint."
        }
