{
	# Only the browser of the tests reaches Caddy, inside the network of compose.yaml, so it needs no admin API, no
	# trusted CA, and no redirect from HTTP.
	admin off
	skip_install_trust
	auto_https disable_redirects
}

# Serve the web app at the URL of the dev server, with a certificate of the internal CA of Caddy. The browser of the
# tests ignores HTTPS errors, so it accepts the certificate without trusting the CA.
localhost.www.dndmapp.dev:4200 {
	tls internal
	reverse_proxy web:4200
}
