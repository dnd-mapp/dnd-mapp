{
    "problemMatcher": [
        {
            "owner": "eslint",
            "pattern": [
                {
                    "regexp": "^(?:\\s*\\S+ \\| )?(/.+)$",
                    "file": 1
                },
                {
                    "regexp": "^(?:\\s*\\S+ \\| )?\\s+(\\d+):(\\d+)\\s+(error|warning)\\s+(.+?)(?:\\s{2,}(\\S+))?$",
                    "line": 1,
                    "column": 2,
                    "severity": 3,
                    "message": 4,
                    "code": 5,
                    "loop": true
                }
            ]
        }
    ]
}
