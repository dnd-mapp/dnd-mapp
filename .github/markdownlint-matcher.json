{
    "problemMatcher": [
        {
            "owner": "markdownlint",
            "pattern": [
                {
                    "regexp": "^(?:\\s*\\S+ \\| )?(.+?):(\\d+)(?::(\\d+))? (error|warning) ([^/\\s]+)\\S* (.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "code": 5,
                    "message": 6
                }
            ]
        }
    ]
}
