{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:best-practices"],
    "timezone": "Europe/Amsterdam",
    "rangeStrategy": "bump",
    "commitMessageTopic": "{{depName}}",
    "labels": ["dependencies"],
    "automergeStrategy": "merge-commit",
    "lockFileMaintenance": {
        "schedule": ["* 0-5 * * 1"],
        "automerge": true
    },
    "vulnerabilityAlerts": {
        "minimumReleaseAge": "3 days",
        "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    "packageRules": [
        {
            "description": "Label the updates of npm packages, Node.js, and pnpm.",
            "matchManagers": ["npm"],
            "addLabels": ["javascript"]
        },
        {
            "description": "Label the updates of actions, runners, and Docker images in workflows.",
            "matchManagers": ["github-actions"],
            "addLabels": ["github_actions"]
        },
        {
            "description": "Label the updates of Docker images.",
            "matchDatasources": ["docker"],
            "addLabels": ["docker"]
        },
        {
            "description": "Use the ci commit type for actions, runners, and Docker images in workflows.",
            "matchManagers": ["github-actions"],
            "semanticCommitType": "ci"
        },
        {
            "description": "Group the non-major updates of actions, runners, and Docker images in workflows.",
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
            "groupName": "GitHub Actions"
        },
        {
            "description": "Merge the non-major updates of actions, runners, and Docker images in workflows without review.",
            "matchManagers": ["github-actions"],
            "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
            "automerge": true
        },
        {
            "description": "Merge the non-major updates of development tools without review. List each catalog of development tools here, so the updates of every other catalog wait for review.",
            "matchDepTypes": [
                "devDependencies",
                "pnpm.catalog.commitlint",
                "pnpm.catalog.lefthook",
                "pnpm.catalog.markdownlint",
                "pnpm.catalog.moon",
                "pnpm.catalog.node",
                "pnpm.catalog.playwright",
                "pnpm.catalog.prettier",
                "pnpm.catalog.vitest"
            ],
            "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
            "automerge": true
        },
        {
            "description": "Group the updates of the Angular catalog, which wait for review, so the framework packages move together.",
            "matchDepTypes": ["pnpm.catalog.angular"],
            "groupName": "Angular"
        },
        {
            "description": "Wait for approval on the Dependency Dashboard before proposing a new major of Node.js or pnpm.",
            "matchDepTypes": ["devEngines.runtime", "devEngines.packageManager"],
            "matchUpdateTypes": ["major"],
            "dependencyDashboardApproval": true
        }
    ]
}
