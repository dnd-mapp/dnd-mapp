{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "cli": {
        "analytics": false,
        "packageManager": "pnpm"
    },
    "schematics": {
        "@schematics/angular:component": {
            "style": "scss",
            "type": "component"
        },
        "@schematics/angular:directive": {
            "type": "directive"
        },
        "@schematics/angular:service": {
            "type": "service"
        },
        "@schematics/angular:guard": {
            "typeSeparator": "."
        },
        "@schematics/angular:interceptor": {
            "typeSeparator": "."
        },
        "@schematics/angular:module": {
            "typeSeparator": "."
        },
        "@schematics/angular:pipe": {
            "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
            "typeSeparator": "."
        }
    },
    "projects": {
        "core-web": {
            "projectType": "library",
            "root": "",
            "sourceRoot": "src",
            "prefix": "dma",
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "options": {
                        "project": "ng-package.json",
                        "tsConfig": "tsconfig.lib.json"
                    }
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "buildTarget": "core-web:build",
                        "coverage": true,
                        "coverageExclude": ["**/index.ts", "**/config/**/*.ts", "**/testing/**/*.ts"],
                        "coverageReporters": ["text-summary", "html"],
                        "coverageThresholds": {
                            "branches": 80,
                            "functions": 80,
                            "lines": 80,
                            "statements": 80
                        },
                        "include": ["**/*.spec.ts"],
                        "isolate": true,
                        "reporters": ["dot"],
                        "runnerConfig": "vitest.config.ts",
                        "ui": true,
                        "watch": true
                    },
                    "configurations": {
                        "ci": {
                            "reporters": ["dot", "github-actions"],
                            "ui": false,
                            "watch": false
                        }
                    }
                }
            }
        }
    }
}
